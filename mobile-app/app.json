{
  "expo": {
    "name": "mobile-app",
    "slug": "mobile-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "This app uses Bluetooth to connect with the ESP32-CAM device.",
        "NSBluetoothPeripheralUsageDescription": "This app uses Bluetooth to communicate with ESP32-CAM.",
        "NSLocalNetworkUsageDescription": "ESP32-CAM камерын дүрсийг дотоод Wi-Fi сүлжээгээр харуулна.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSAllowsArbitraryLoadsInWebContent": true,
          "NSExceptionDomains": {
            "10.0.0.0/8": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            },
            "172.16.0.0/12": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            },
            "192.168.0.0/16": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            }
          }
        }
      },
      "bundleIdentifier": "com.softwarelhagvadorj.mobile-app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.INTERNET"
      ],
      "package": "com.softwarelhagvadorj.mobileapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": [
            "peripheral",
            "central"
          ],
          "bluetoothAlwaysPermission": "Allow AI Vision to connect to ESP32 via Bluetooth."
        }
      ],
      "./plugins/withCameraNetwork"
    ]
  }
}
